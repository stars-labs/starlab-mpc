{
  "name": "@stars-labs/monorepo",
  "description": "MPC Wallet Monorepo - Multi-Party Computation wallet with FROST signatures",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/@starlab/*"
  ],
  "scripts": {
    "build": "./scripts/build-all.sh",
    "build:wasm": "cd packages/@starlab/core-wasm && bun run build",
    "build:wasm:dev": "cd packages/@starlab/core-wasm && bun run build:dev",
    "test": "./scripts/test-all.sh",
    "clean": "./scripts/clean-all.sh",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@solana/web3.js": "^1.99.0",
    "prettier": "^3.9.9"
  }
}